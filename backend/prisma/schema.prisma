generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  hashedPassword String
  name       String?
  role       String     @default("TENANT")
  createdAt  DateTime   @default(now())
  favorites  Favorite[]
}

model Area {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  imageUrl    String?
  description String?    @db.Text
  properties  Property[]
}

model Property {
  id            String         @id @default(uuid())
  title         String
  slug          String         @unique
  description   String?        @db.Text
  address       String
  city          String
  postCode      String?
  areaId        String?
  area          Area?          @relation(fields: [areaId], references: [id])
  listingType   ListingType    @default(RENTAL)
  beds          Int
  baths         Int
  areaSqFt      Int
  pricePerMonth Decimal       @db.Decimal(12, 2)
  isFeatured    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  images        PropertyImage[]
  enquiries     Enquiry[]
  favorites    Favorite[]
}

enum ListingType {
  RENTAL
  HOLIDAY_LET
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  order      Int      @default(0)
}

model Enquiry {
  id        String    @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String    @db.Text
  consent   Boolean
  source    String    @default("CONTACT_PAGE")
  propertyId String?
  property  Property? @relation(fields: [propertyId], references: [id])
  createdAt DateTime @default(now())
}

model Favorite {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@unique([userId, propertyId])
}

model MaintenanceRequest {
  id                   String   @id @default(uuid())
  tenantName           String   @map("tenant_name")
  tenantEmail          String   @default("")
  propertyAddressOrRef String   @map("property_address")
  issueCategory        String   @map("issue_type")
  description          String   @db.Text
  urgency              String   @default("MEDIUM")
  status               String   @default("pending")
  createdAt            DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(uuid())
  title       String
  slug        String     @unique
  excerpt     String?    @db.Text
  body        String?    @db.Text
  author      String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Testimonial {
  id         String   @id @default(uuid())
  authorName String
  role       String
  content    String   @db.Text
  rating     Int?
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
}
